# =============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO (sin valores reales)
#  Copia este archivo como ".env.local" y rellena tus valores.
#  El archivo .env.local NUNCA se sube a git (está en .gitignore).
# =============================================================

# Mercado Pago: Access Token (de PRUEBA empieza con TEST-, el de
# PRODUCCIÓN con APP_USR-). Sácalo de tu panel de Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública del sitio. En local: http://localhost:3000
# En producción: tu dominio, ej https://konamoda.pe
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contraseña del panel /admin. Usa una fuerte y única (12+ caracteres).
ADMIN_PASSWORD=

# Clave interna para firmar la sesión del panel. Genera una al azar, ej:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# =============================================================
#  AGENTE DE TELEGRAM (opcional) — ver AGENTE.md para el paso a paso
# =============================================================

# Token del bot, te lo da @BotFather en Telegram al crear el bot.
TELEGRAM_BOT_TOKEN=

# Clave inventada por ti (larga y al azar). Sirve para que nadie más
# que Telegram pueda mandarle órdenes al agente. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Quién puede darle órdenes al agente. Son números de chat de Telegram,
# separados por coma. Si no sabes el tuyo, escríbele al bot y él te lo dice.
TELEGRAM_ALLOWED_CHAT_IDS=

# Clave de la IA (Google Gemini). Es GRATIS: sácala en
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo a usar. Opcional: por defecto gemini-2.5-flash (gratuito).
GEMINI_MODEL=

# =============================================================
#  BASE DE DATOS (necesaria en producción)
#  En Vercel el disco es de SOLO LECTURA: sin esto, los cambios del
#  panel y del agente NO se guardan. Es gratis (Upstash Redis).
#  Si instalas Upstash desde el Marketplace de Vercel, estas dos
#  variables aparecen solas. En local no hacen falta.
# =============================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
